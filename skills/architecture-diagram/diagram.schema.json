{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture diagram",
  "type": "object",
  "required": ["width", "height", "summary", "nodes", "edges"],
  "properties": {
    "title": { "type": "string", "description": "Name shown in the SVG title. Defaults to the file name." },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "summary": { "type": "string", "description": "One or two sentences that tell the flow. Stored as the SVG description." },
    "theme": { "enum": ["sage", "blue", "mono", "violet", "ember"], "description": "Palette. sage (green and sand) is the default; every theme has a light and a dark variant." },
    "colorsDark": { "type": "object", "description": "Override single entries of the dark palette." },
    "colors": { "type": "object", "description": "Override single palette entries, e.g. { \"main\": { \"fill\": \"#eef\" } }." },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "x", "y", "w", "h"],
        "properties": {
          "title": { "type": "string" },
          "x": { "type": "number", "description": "Left edge." },
          "y": { "type": "number", "description": "Top edge." },
          "w": { "type": "number" },
          "h": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "title"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number", "description": "Center of the box." },
          "y": { "type": "number", "description": "Center of the box." },
          "title": { "type": "string" },
          "note": { "type": "string", "description": "One line: the technology or host." },
          "tone": { "enum": ["main", "accent", "outside"] }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "dashed": { "type": "boolean" },
          "both": { "type": "boolean", "description": "Arrowheads on both ends." },
          "route": { "enum": ["h", "v", "hvh", "vhv", "hv", "vh"] },
          "offset": { "type": "number" },
          "fromOffset": { "type": "number" },
          "toOffset": { "type": "number" },
          "bend": { "type": "number" },
          "labelAt": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  }
}
